namespace LiuCertificate
def s : Nat := 16777216
def q : Nat := 1099511627776
structure Box where
  al : Nat
  ah : Nat
  bl : Nat
  bh : Nat
def absDiff (a b : Nat) : Nat := (a-b)+(b-a)
def localCheck (b : Box) : Bool :=
  let total := b.al+b.bl+s
  [absDiff (2*b.al) (b.bh+s), absDiff (2*b.ah) (b.bl+s),
   absDiff (2*b.bl) (b.ah+s), absDiff (2*b.bh) (b.al+s),
   absDiff (2*s) (b.ah+b.bh), absDiff (2*s) (b.al+b.bl)].all
     (fun d => 10*d <= total)
def emptyCheck (b : Box) : Bool := b.ah+b.bh < s || b.al > b.bh
def radicalCheck (ul uh vl vh wl wh m w : Nat) : Bool :=
  4*s^2*m^2 <= q^2*(2*vl^2+2*wl^2-uh^2) &&
  s^2*(vh+wh)^2*w^2 <= q^2*vl*wl*(ul+vl+wl)*(vl+wl-uh)
def intervalCheck (b : Box) (ma mb mc wa wb wc : Nat) : Bool :=
  radicalCheck b.al b.ah b.bl b.bh s s ma wa &&
  radicalCheck b.bl b.bh s s b.al b.ah mb wb &&
  radicalCheck s s b.al b.ah b.bl b.bh mc wc &&
  q^4*(b.ah+b.bh+s)^4 < 16*s^4*(wa+wb+wc)*(ma^3+mb^3+mc^3)
inductive Cert where
  | empty : Cert
  | localPatch : Cert
  | interval (ma mb mc wa wb wc : Nat) : Cert
  | split (left right : Cert) : Cert
def check (b : Box) : Cert → Bool
  | .empty => emptyCheck b
  | .localPatch => localCheck b
  | .interval ma mb mc wa wb wc => intervalCheck b ma mb mc wa wb wc
  | .split left right =>
    if b.ah-b.al >= b.bh-b.bl then
      let m := (b.al+b.ah)/2
      check {b with ah := m} left && check {b with al := m} right
    else
      let m := (b.bl+b.bh)/2
      check {b with bh := m} left && check {b with bl := m} right

